// crates/palaco-quay/src/provenance.rs

use crate::model::{RecordId, SourceId};

/// Cryptographic or logical generation identifier in the lineage chain.
#[derive(Debug, Clone, PartialEq, Eq, Hash)]
pub struct GenerationId(u64);

/// Classification of how a record entered or transformed within the Quay.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum ProvenanceKind {
    /// Initial genesis injection into the system.
    Genesis,
    /// Direct evolution from a single predecessor record.
    Transition,
    /// Merged derivation from multiple source records.
    Consensus,
}

/// Immutable provenance record establishing strict lineage.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct Provenance {
    record_id: RecordId,
    source: SourceId,
    kind: ProvenanceKind,
    generation: GenerationId,
    predecessor: Option<RecordId>,
}

impl Provenance {
    /// Creates a genesis provenance for an origin record.
    pub fn genesis(record_id: RecordId, source: SourceId) -> Self {
        Self {
            record_id,
            source,
            kind: ProvenanceKind::Genesis,
            generation: GenerationId(0),
            predecessor: None,
        }
    }

    /// Creates a transition provenance deriving from a known predecessor.
    pub fn transition(
        record_id: RecordId,
        source: SourceId,
        predecessor: RecordId,
        generation_index: u64,
    ) -> Self {
        Self {
            record_id,
            source,
            kind: ProvenanceKind::Transition,
            generation: GenerationId(generation_index),
            predecessor: Some(predecessor),
        }
    }

    /// Returns the record identifier associated with this provenance.
    pub fn record_id(&self) -> &RecordId {
        &self.record_id
    }

    /// Returns the source that submitted or triggered this lineage.
    pub fn source(&self) -> &SourceId {
        &self.source
    }

    /// Returns the provenance classification.
    pub fn kind(&self) -> ProvenanceKind {
        self.kind
    }

    /// Returns the generation index in the lineage chain.
    pub fn generation(&self) -> &GenerationId {
        &self.generation
    }

    /// Returns the optional predecessor record identifier.
    pub fn predecessor(&self) -> Option<&RecordId> {
        self.predecessor.as_ref()
    }
}

2. Lineage Verificatie Regels
Een provenance-keten mag nooit los hangen (behalve bij Genesis). De motor dwingt dit af via strikte regels:
impl Provenance {
    /// Validates internal consistency of the provenance metadata.
    pub fn validate_integrity(&self) -> Result<(), ProvenanceError> {
        match self.kind {
            ProvenanceKind::Genesis => {
                if self.predecessor.is_some() {
                    return Err(ProvenanceError::InvalidGenesisPredecessor);
                }
                if self.generation.0 != 0 {
                    return Err(ProvenanceError::InvalidGenesisGeneration);
                }
            }
            ProvenanceKind::Transition | ProvenanceKind::Consensus => {
                if self.predecessor.is_none() {
                    return Err(ProvenanceError::MissingPredecessor);
                }
            }
        }
        Ok(())
    }
}

/// Errors produced during provenance verification.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum ProvenanceError {
    /// Genesis records cannot have a predecessor.
    InvalidGenesisPredecessor,
    /// Genesis records must reside at generation zero.
    InvalidGenesisGeneration,
    /// Non-genesis records must explicitly reference a predecessor.
    MissingPredecessor,
}

