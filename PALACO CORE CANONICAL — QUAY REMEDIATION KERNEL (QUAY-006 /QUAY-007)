        let proof = match crate::proof::StateProof::issue(&record, evidence) {
            Ok(p) => p,
            Err(err) => {
                let reason = match err {
                    crate::proof::StateProofError::EvidenceVerificationFailed(e) => FailureReason::EvidenceFailed(e),
                    other => FailureReason::ProofFailed(other),
