// crates/palaco-quay/src/proof.rs

use crate::evidence::{EvidenceBundle, EvidenceError};
use crate::model::{QuayRecord, ProvenQuayRecord};
use crate::provenance::Provenance;

/// Cryptographic or logical proof that a record satisfies all transition invariants.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct StateProof {
    record_id: crate::model::RecordId,
    payload_digest: crate::model::PayloadDigest,
    evidence_bundle: EvidenceBundle,
}

impl StateProof {
    /// Attempts to issue a StateProof by strictly verifying the provided EvidenceBundle.
    pub fn issue(record: &QuayRecord, evidence_bundle: EvidenceBundle) -> Result<Self, StateProofError> {
        // 1. Verify strict binding between record and evidence payload digest
        if record.payload_digest() != evidence_bundle.payload_digest() {
            return Err(StateProofError::PayloadDigestMismatch);
        }

        // 2. Run comprehensive verification on the evidence bundle and its provenance
        evidence_bundle.verify_all()
            .map_err(StateProofError::EvidenceVerificationFailed)?;

        Ok(Self {
            record_id: record.id().clone(),
            payload_digest: record.payload_digest().clone(),
            evidence_bundle,
        })
    }

    /// Returns the verified record identifier.
    pub fn record_id(&self) -> &crate::model::RecordId {
        &self.record_id
    }

    /// Returns the payload digest associated with the proof.
    pub fn payload_digest(&self) -> &crate::model::PayloadDigest {
        &self.payload_digest
    }

    /// Consumes the proof and transforms a raw QuayRecord into a ProvenQuayRecord.
    pub fn seal(self, record: QuayRecord, provenance: Provenance) -> Result<ProvenQuayRecord, StateProofError> {
        // Enforce internal integrity check before sealing
        if record.id() != &self.record_id {
            return Err(StateProofError::RecordIdMismatch);
        }

        let evidence = self.evidence_bundle.clone();

        // Construct the immutable, proven capability
        Ok(ProvenQuayRecord::from_verified(
            record,
            provenance,
            evidence,
            self,
        ))
    }
}

/// Errors produced during StateProof issuance and sealing.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum StateProofError {
    /// The payload digest in the record does not match the evidence bundle.
    PayloadDigestMismatch,
    /// Underlying evidence or provenance verification failed.
    EvidenceVerificationFailed(EvidenceError),
    /// The record identifier does not match the sealed proof.
    RecordIdMismatch,
}

