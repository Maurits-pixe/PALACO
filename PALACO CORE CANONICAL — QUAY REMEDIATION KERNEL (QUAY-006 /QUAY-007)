/// Represents the structured outcome of a validation check.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum ValidationResult {
    /// Validation passed successfully.
    Valid,
    /// Validation failed with specific structural or invariant errors.
    Invalid(Vec<ValidationError>),
}

impl ValidationResult {
    /// Returns true if the validation result is valid.
    pub fn is_valid(&self) -> bool {
        matches!(self, Self::Valid)
    }
}

/// Provides validation functions for canonical PALACO primitives.
pub struct Validator;

impl Validator {
    /// Validates a cryptographic Hash256 to ensure it is non-zero.
    pub fn validate_hash(hash: &Hash256) -> ValidationResult {
        if hash.0 == [0u8; 32] {
            ValidationResult::Invalid(vec![ValidationError::InvariantViolation(
                "Hash256 cannot be a zero-buffer".to_string(),
            )])
        } else {
            ValidationResult::Valid
        }
    }

    /// Validates a NodeId to ensure proper formatting and non-zero bytes.
    pub fn validate_node_id(node_id: &NodeId) -> ValidationResult {
        if node_id.0 == [0u8; 32] {
            ValidationResult::Invalid(vec![ValidationError::InvalidIdentifier(
                "NodeId cannot be a zero-buffer".to_string(),
            )])
        } else {
            ValidationResult::Valid
        }
    }

    /// Validates a BaselineId against constitutional consistency rules.
    pub fn validate_baseline(baseline_id: &BaselineId) -> ValidationResult {
        if baseline_id.0 == [0u8; 32] {
            ValidationResult::Invalid(vec![ValidationError::BaselineInconsistent(
                "BaselineId root hash is uninitialized".to_string(),
            )?]) // Handled via ValidationError mapping or direct variant
        } else {
            ValidationResult::Valid
        }
    }
}

