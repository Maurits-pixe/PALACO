// crates/palaco-quay/src/replay.rs

use crate::model::RecordId;
use std::collections::HashSet;

/// Registry tracking processed record identifiers to prevent replay attacks.
#[derive(Debug, Default, Clone)]
pub struct ReplayRegistry {
    seen_records: HashSet<RecordId>,
}

impl ReplayRegistry {
    /// Creates a new, empty replay registry.
    pub fn new() -> Self {
        Self {
            seen_records: HashSet::new(),
        }
    }

    /// Checks if a record has already been processed through the Quay.
    pub fn check_replay(&self, record_id: &RecordId) -> Result<(), ReplayError> {
        if self.seen_records.contains(record_id) {
            return Err(ReplayError::ReplayDetected(record_id.clone()));
        }
        Ok(())
    }

    /// Registers a successfully proven record to prevent future replays.
    pub fn register(&mut self, record_id: RecordId) -> Result<(), ReplayError> {
        if !self.seen_records.insert(record_id.clone()) {
            return Err(ReplayError::ReplayDetected(record_id));
        }
        Ok(())
    }
}

/// Errors produced during replay detection.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum ReplayError {
    /// A duplicate record identifier was submitted, indicating a replay attempt.
    ReplayDetected(RecordId),
}

