2. De Citadel Kernel Bridge
In de kernel integreren we de QuayEngine als een vaste poortwachter voor alle binnenkomende runtime-events of state-transitions.
// crates/palaco-kernel/src/quay_bridge.rs

use palaco_quay::{
    QuayEngine, QuayResult, ReplayRegistry, QuayRecord, Provenance, EvidenceBundle, RecordId, SourceId
};

/// The Citadel Kernel Quay subsystem.
pub struct KernelQuaySubsystem {
    registry: ReplayRegistry,
}

impl KernelQuaySubsystem {
    /// Initializes a new kernel quay subsystem.
    pub fn new() -> Self {
        Self {
            registry: ReplayRegistry::new(),
        }
    }

    /// Submits a raw record through the kernel boundary with full constitutional checks.
    pub fn submit(
        &mut self,
        record: QuayRecord,
        provenance: Provenance,
        evidence: EvidenceBundle,
        timestamp_nanos: u64,
    ) -> QuayResult {
        QuayEngine::process_with_replay(
            &mut self.registry,
            record,
            provenance,
            evidence,
            timestamp_nanos,
        )
    }
}

