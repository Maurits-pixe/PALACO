{
  "name": "or6it-world-eva-001-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "npm run schema:check && vite build --configLoader native",
    "preview": "vite preview --configLoader native",
    "schema:generate": "node scripts/generate-validator.mjs",
    "schema:check": "node scripts/generate-validator.mjs --check",
    "test": "npm run schema:check && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.9",
    "ajv": "8.20.0",
    "vite": "7.3.7"
  }
}
