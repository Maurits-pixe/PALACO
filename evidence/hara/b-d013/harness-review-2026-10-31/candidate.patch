diff --git a/modules/hara/hannie-b-d013/tools/evidence-checks.mjs b/modules/hara/hannie-b-d013/tools/evidence-checks.mjs
new file mode 100644
index 0000000..f7ff83b
--- /dev/null
+++ b/modules/hara/hannie-b-d013/tools/evidence-checks.mjs
@@ -0,0 +1,9 @@
+// This suite has 20 required controls. A filtered or truncated run is not proof.
+export function evidencePassed({compile, run, counts, sourceUnchanged, commit}) {
+  return compile.status === 0 && !compile.error && !compile.signal &&
+    run.status === 0 && !run.error && !run.signal &&
+    counts.tests === 20 && counts.pass === 20 &&
+    ['fail', 'cancelled', 'skipped', 'todo'].every(k => counts[k] === 0) &&
+    sourceUnchanged === true && commit.status === 0 && !commit.error &&
+    !commit.signal && /^[a-f0-9]{40}$/.test(commit.stdout.trim());
+}
diff --git a/modules/hara/hannie-b-d013/tools/evidence-checks.test.mjs b/modules/hara/hannie-b-d013/tools/evidence-checks.test.mjs
new file mode 100644
index 0000000..e5bf77a
--- /dev/null
+++ b/modules/hara/hannie-b-d013/tools/evidence-checks.test.mjs
@@ -0,0 +1,25 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {evidencePassed} from './evidence-checks.mjs';
+
+const complete = () => ({
+  compile: {status: 0}, run: {status: 0},
+  counts: {tests: 20, pass: 20, fail: 0, cancelled: 0, skipped: 0, todo: 0},
+  sourceUnchanged: true, commit: {status: 0, stdout: 'a'.repeat(40) + '\n'},
+});
+test('complete evidence passes', () => assert.equal(evidencePassed(complete()), true));
+for (const [name, change] of [
+  ['filtered run', x => { x.counts.tests = x.counts.pass = 1; }],
+  ['missing summary', x => { x.counts = {}; }],
+  ['missing cancellation count', x => { delete x.counts.cancelled; }],
+  ['test failure', x => { x.run.status = 1; }],
+  ['spawn error despite zero exit', x => { x.run.error = {code: 'EPERM'}; }],
+  ['compiler error despite zero exit', x => { x.compile.error = {code: 'EPERM'}; }],
+  ['killed child', x => { x.run.signal = 'SIGKILL'; }],
+  ['changed sources', x => { x.sourceUnchanged = false; }],
+  ['missing commit', x => { x.commit.stdout = ''; }],
+  ['commit lookup error', x => { x.commit.error = {code: 'EPERM'}; }],
+  ...['fail', 'cancelled', 'skipped', 'todo'].map(k => [k, x => { x.counts[k] = 1; }]),
+]) test(name + ' cannot pass', () => {
+  const input = complete(); change(input); assert.equal(evidencePassed(input), false);
+});
