{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palaco.example/schemas/palaco/PMS-001.schema.json",
  "title": "PMS-001 — PALACO Canonical MetaSchema — MVP",
  "description": "Shared registry metadata for the 30 PALACO object families. ADR, SVC, COM and REQ have additional minimum contracts. Other families use the shared contract.",
  "$comment": "Structural validation only: this schema does not establish CANONICAL status, approval authority, evidence authenticity, reference existence, graph completeness, date ordering or legal lifecycle transitions. Resolve PMS-002 from the local bundle; no network retrieval is needed.",
  "type": "object",
  "required": ["object_type", "metadata", "ownership", "lifecycle", "approval", "classification", "traceability", "verification", "audit"],
  "properties": {
    "object_type": {
      "enum": ["FE", "PDP", "PCS", "GOV", "CAP", "DOM", "OBJ", "POL", "RSK", "REQ", "ARC", "ADR", "INT", "DAT", "APP", "SVC", "API", "MOD", "REP", "CFG", "COM", "VER", "TST", "EVD", "AUD", "RUN", "MON", "EVT", "INC", "CHG"]
    },
    "metadata": { "$ref": "#/$defs/Metadata" },
    "ownership": { "$ref": "#/$defs/Ownership" },
    "lifecycle": { "$ref": "#/$defs/Lifecycle" },
    "approval": { "$ref": "#/$defs/Approval" },
    "classification": { "$ref": "#/$defs/Classification" },
    "traceability": { "$ref": "#/$defs/Traceability" },
    "verification": { "$ref": "#/$defs/Verification" },
    "audit": { "$ref": "#/$defs/Audit" },
    "repository": { "$ref": "#/$defs/Repository" },
    "runtime": { "$ref": "#/$defs/Runtime" },
    "service_level": { "$ref": "#/$defs/ServiceLevel" },
    "evidence": { "$ref": "#/$defs/Evidence" },
    "compliance": { "$ref": "#/$defs/References" },
    "risk": {
      "allOf": [
        { "$ref": "#/$defs/ObjectId" },
        { "pattern": "^RSK-" }
      ]
    },
    "decision": { "$ref": "#/$defs/NonEmptyString" },
    "context": { "$ref": "#/$defs/NonEmptyString" },
    "consequences": { "$ref": "#/$defs/NonEmptyString" },
    "approved_by": {
      "allOf": [
        { "$ref": "#/$defs/ObjectId" },
        { "pattern": "^GOV-" }
      ]
    },
    "architecture_ref": {
      "allOf": [
        { "$ref": "#/$defs/ObjectId" },
        { "pattern": "^ARC-" }
      ]
    },
    "requirement_refs": {
      "allOf": [
        { "$ref": "#/$defs/References" },
        { "minItems": 1, "items": { "pattern": "^REQ-" } }
      ]
    },
    "capability_ref": {
      "allOf": [
        { "$ref": "#/$defs/ObjectId" },
        { "pattern": "^CAP-" }
      ]
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/NonEmptyString" }
    },
    "control_type": { "enum": ["Preventive", "Detective", "Corrective", "Compensating"] },
    "dependencies": { "$ref": "#/$defs/References" },
    "observability": {
      "type": "object",
      "required": ["logging", "metrics", "tracing"],
      "properties": {
        "logging": { "type": "boolean" },
        "metrics": { "type": "boolean" },
        "tracing": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "oneOf": [
    { "properties": { "object_type": { "const": "FE" }, "metadata": { "properties": { "id": { "pattern": "^FE-" } } } } },
    { "properties": { "object_type": { "const": "PDP" }, "metadata": { "properties": { "id": { "pattern": "^PDP-" } } } } },
    { "properties": { "object_type": { "const": "PCS" }, "metadata": { "properties": { "id": { "pattern": "^PCS-" } } } } },
    { "properties": { "object_type": { "const": "GOV" }, "metadata": { "properties": { "id": { "pattern": "^GOV-" } } } } },
    { "properties": { "object_type": { "const": "CAP" }, "metadata": { "properties": { "id": { "pattern": "^CAP-" } } } } },
    { "properties": { "object_type": { "const": "DOM" }, "metadata": { "properties": { "id": { "pattern": "^DOM-" } } } } },
    { "properties": { "object_type": { "const": "OBJ" }, "metadata": { "properties": { "id": { "pattern": "^OBJ-" } } } } },
    { "properties": { "object_type": { "const": "POL" }, "metadata": { "properties": { "id": { "pattern": "^POL-" } } } } },
    { "properties": { "object_type": { "const": "RSK" }, "metadata": { "properties": { "id": { "pattern": "^RSK-" } } } } },
    { "properties": { "object_type": { "const": "REQ" }, "metadata": { "properties": { "id": { "pattern": "^REQ-" } } } } },
    { "properties": { "object_type": { "const": "ARC" }, "metadata": { "properties": { "id": { "pattern": "^ARC-" } } } } },
    { "properties": { "object_type": { "const": "ADR" }, "metadata": { "properties": { "id": { "pattern": "^ADR-" } } } } },
    { "properties": { "object_type": { "const": "INT" }, "metadata": { "properties": { "id": { "pattern": "^INT-" } } } } },
    { "properties": { "object_type": { "const": "DAT" }, "metadata": { "properties": { "id": { "pattern": "^DAT-" } } } } },
    { "properties": { "object_type": { "const": "APP" }, "metadata": { "properties": { "id": { "pattern": "^APP-" } } } } },
    { "properties": { "object_type": { "const": "SVC" }, "metadata": { "properties": { "id": { "pattern": "^SVC-" } } } } },
    { "properties": { "object_type": { "const": "API" }, "metadata": { "properties": { "id": { "pattern": "^API-" } } } } },
    { "properties": { "object_type": { "const": "MOD" }, "metadata": { "properties": { "id": { "pattern": "^MOD-" } } } } },
    { "properties": { "object_type": { "const": "REP" }, "metadata": { "properties": { "id": { "pattern": "^REP-" } } } } },
    { "properties": { "object_type": { "const": "CFG" }, "metadata": { "properties": { "id": { "pattern": "^CFG-" } } } } },
    { "properties": { "object_type": { "const": "COM" }, "metadata": { "properties": { "id": { "pattern": "^COM-" } } } } },
    { "properties": { "object_type": { "const": "VER" }, "metadata": { "properties": { "id": { "pattern": "^VER-" } } } } },
    { "properties": { "object_type": { "const": "TST" }, "metadata": { "properties": { "id": { "pattern": "^TST-" } } } } },
    { "properties": { "object_type": { "const": "EVD" }, "metadata": { "properties": { "id": { "pattern": "^EVD-" } } } } },
    { "properties": { "object_type": { "const": "AUD" }, "metadata": { "properties": { "id": { "pattern": "^AUD-" } } } } },
    { "properties": { "object_type": { "const": "RUN" }, "metadata": { "properties": { "id": { "pattern": "^RUN-" } } } } },
    { "properties": { "object_type": { "const": "MON" }, "metadata": { "properties": { "id": { "pattern": "^MON-" } } } } },
    { "properties": { "object_type": { "const": "EVT" }, "metadata": { "properties": { "id": { "pattern": "^EVT-" } } } } },
    { "properties": { "object_type": { "const": "INC" }, "metadata": { "properties": { "id": { "pattern": "^INC-" } } } } },
    { "properties": { "object_type": { "const": "CHG" }, "metadata": { "properties": { "id": { "pattern": "^CHG-" } } } } }
  ],
  "allOf": [
    {
      "if": { "properties": { "object_type": { "const": "ADR" } }, "required": ["object_type"] },
      "then": { "required": ["decision", "context", "consequences", "approved_by", "architecture_ref"] }
    },
    {
      "if": { "properties": { "object_type": { "const": "SVC" } }, "required": ["object_type"] },
      "then": { "required": ["requirement_refs", "architecture_ref", "repository", "runtime", "service_level", "dependencies", "observability"] }
    },
    {
      "if": { "properties": { "object_type": { "const": "COM" } }, "required": ["object_type"] },
      "then": {
        "required": ["control_type", "risk", "evidence"],
        "properties": {
          "verification": { "required": ["verification_ref"] },
          "evidence": { "minItems": 1 }
        }
      }
    },
    {
      "if": { "properties": { "object_type": { "const": "REQ" } }, "required": ["object_type"] },
      "then": { "required": ["capability_ref", "acceptance_criteria"] }
    },
    {
      "if": { "properties": { "object_type": { "const": "AUD" } }, "required": ["object_type"] },
      "then": { "required": ["evidence"], "properties": { "evidence": { "minItems": 1 } } }
    }
  ],
  "$defs": {
    "NonEmptyString": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "ObjectId": { "$ref": "PMS-002.schema.json#/$defs/ObjectId" },
    "References": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/ObjectId" }
    },
    "Metadata": {
      "type": "object",
      "required": ["id", "name", "domain", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/ObjectId" },
        "name": { "$ref": "#/$defs/NonEmptyString" },
        "domain": { "$ref": "#/$defs/NonEmptyString" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "description": { "$ref": "#/$defs/NonEmptyString" }
      },
      "additionalProperties": false
    },
    "Ownership": {
      "type": "object",
      "required": ["business", "architecture", "technical", "verification", "custodian"],
      "properties": {
        "business": { "$ref": "#/$defs/NonEmptyString" },
        "architecture": { "$ref": "#/$defs/NonEmptyString" },
        "technical": { "$ref": "#/$defs/NonEmptyString" },
        "verification": { "$ref": "#/$defs/NonEmptyString" },
        "custodian": { "$ref": "#/$defs/NonEmptyString" }
      },
      "additionalProperties": false
    },
    "Lifecycle": {
      "description": "Current state only, not a transition history. Approval date is optional while drafting.",
      "type": "object",
      "required": ["status", "created", "next_review"],
      "properties": {
        "status": { "enum": ["Proposed", "Draft", "Review", "Approved", "Active", "Deprecated", "Retired", "Archived"] },
        "created": { "type": "string", "format": "date" },
        "approved": { "type": "string", "format": "date" },
        "next_review": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },
    "Approval": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["Pending", "Approved", "Rejected"] },
        "authority": { "$ref": "#/$defs/NonEmptyString" },
        "approval_ref": { "$ref": "#/$defs/NonEmptyString" }
      },
      "if": { "properties": { "status": { "const": "Approved" } }, "required": ["status"] },
      "then": { "required": ["authority", "approval_ref"] },
      "additionalProperties": false
    },
    "Classification": {
      "type": "object",
      "required": ["criticality", "confidentiality", "integrity", "availability"],
      "properties": {
        "criticality": { "enum": ["Low", "Medium", "High", "Critical"] },
        "confidentiality": { "enum": ["Public", "Internal", "Confidential", "Restricted"] },
        "integrity": { "enum": ["Low", "Medium", "High"] },
        "availability": { "enum": ["Low", "Medium", "High"] }
      },
      "additionalProperties": false
    },
    "Traceability": {
      "description": "Upstream references may be empty for roots. Embedded edges must be checked against the enclosing object's ID by the registry.",
      "type": "object",
      "required": ["upstream", "relationships"],
      "properties": {
        "upstream": { "$ref": "#/$defs/References" },
        "relationships": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "PMS-002.schema.json" }
        }
      },
      "additionalProperties": false
    },
    "Verification": {
      "type": "object",
      "required": ["method", "frequency", "status"],
      "properties": {
        "method": { "$ref": "#/$defs/NonEmptyString" },
        "frequency": { "$ref": "#/$defs/NonEmptyString" },
        "status": { "enum": ["Pending", "Passed", "Failed", "NotApplicable"] },
        "verification_ref": {
          "allOf": [{ "$ref": "#/$defs/ObjectId" }, { "pattern": "^VER-" }]
        }
      },
      "additionalProperties": false
    },
    "Audit": {
      "description": "Audit trail references, not proof that an audit has been performed.",
      "type": "object",
      "required": ["updated_at", "updated_by", "audit_refs"],
      "properties": {
        "updated_at": { "type": "string", "format": "date-time" },
        "updated_by": { "$ref": "#/$defs/NonEmptyString" },
        "audit_refs": {
          "allOf": [{ "$ref": "#/$defs/References" }, { "items": { "pattern": "^AUD-" } }]
        }
      },
      "additionalProperties": false
    },
    "Repository": {
      "type": "object",
      "required": ["repository_ref", "repository_url"],
      "properties": {
        "repository_ref": {
          "allOf": [{ "$ref": "#/$defs/ObjectId" }, { "pattern": "^REP-" }]
        },
        "repository_url": { "type": "string", "format": "uri" },
        "path": { "$ref": "#/$defs/NonEmptyString" },
        "revision": { "$ref": "#/$defs/NonEmptyString" }
      },
      "additionalProperties": false
    },
    "Runtime": {
      "type": "object",
      "required": ["runtime_ref", "environment", "version"],
      "properties": {
        "runtime_ref": {
          "allOf": [{ "$ref": "#/$defs/ObjectId" }, { "pattern": "^RUN-" }]
        },
        "environment": { "enum": ["Development", "Test", "Staging", "Production"] },
        "version": { "$ref": "#/$defs/NonEmptyString" }
      },
      "additionalProperties": false
    },
    "ServiceLevel": {
      "type": "object",
      "required": ["availability_target", "recovery_target"],
      "properties": {
        "availability_target": { "type": "number", "minimum": 0, "maximum": 100, "description": "Availability percentage." },
        "recovery_target": { "type": "string", "pattern": "^PT(?:[0-9]+H(?:[0-9]+M)?(?:[0-9]+S)?|[0-9]+M(?:[0-9]+S)?|[0-9]+S)$", "description": "Recovery time as an ISO 8601 duration restricted to integer hours, minutes and seconds, e.g. PT4H." }
      },
      "additionalProperties": false
    },
    "Evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "allOf": [{ "$ref": "#/$defs/ObjectId" }, { "pattern": "^EVD-" }]
      }
    }
  }
}
