FROM node:24.22.1-bookworm-slim AS build
ARG APP_PATH
WORKDIR /app
COPY ${APP_PATH}/package*.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY ${APP_PATH}/ ./
ARG VITE_BASTION_API_URL=/api
ARG VITE_BASTION_DEMO=false
ENV VITE_BASTION_API_URL=${VITE_BASTION_API_URL}
ENV VITE_BASTION_DEMO=${VITE_BASTION_DEMO}
RUN npm run build

FROM nginx:stable-alpine
COPY docker/frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s CMD wget -q -O /dev/null http://127.0.0.1/health
