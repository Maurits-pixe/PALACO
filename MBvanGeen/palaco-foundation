+}
+
+/// Lifecycle state of an execution permit.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum PermitState {
+    /// Permit has been issued but is not active yet.
+    Issued,
+    /// Permit is currently executable.
+    Active,
+    /// Permit has been explicitly revoked.
+    Revoked,
+    /// Permit has passed its validity window.
+    Expired,
+}
+
+/// Living Kernel governance state machine.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum KernelGovernanceState {
+    /// Kernel action is being observed.
+    Observing,
+    /// Governance controls are being evaluated.
+    Validating,
+    /// Certification evidence is being assembled.
+    Certifying,
+    /// Execution is authorized.
+    Approved,
+    /// Execution is constitutionally denied.
+    Blocked,
+}
+
+/// Canonical ordering result for PALACO timestamps.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum TimestampOrder {
+    /// Left timestamp is earlier than the right timestamp.
+    Before,
+    /// Timestamps are equal.
+    Equal,
+    /// Left timestamp is later than the right timestamp.
+    After,
+}
+
+/// Governance failure; all failures are fail-closed.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum GovernanceError {
+    /// Required identity or reference is empty.
+    MissingReference(&'static str),
+    /// Permit is not in an executable state.
+    PermitNotActive,
+    /// Current time falls outside the permit validity window.
+    PermitOutsideValidityWindow,
+    /// Authority signature is missing.
+    MissingAuthoritySignature,
+    /// The external verifier rejected the authority.
+    AuthorityVerificationFailed,
+    /// State proof is incomplete.
+    InvalidStateProof(&'static str),
+}
+
+/// Certification record produced before execution.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct CertificationRecord {
+    /// Certification identifier.
+    pub certification_id: CertificationId,
+    /// Evidence digest bound to the certification.
+    pub evidence_hash: EvidenceHash,
+}
+
+/// Constitutionally scoped permission to execute a kernel action.
+///
+/// `approved: bool` is intentionally absent. The permit's state, validity
+/// window, references, and authority proof form the execution boundary.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ExecutionPermit {
+    /// Certification backing the permit.
+    pub certification_id: CertificationId,
+    /// Evidence digest backing the permit.
+    pub evidence_hash: EvidenceHash,
+    /// Signature of the certifying authority.
+    pub authority_signature: Signature,
+    /// Permit issuance timestamp.
+    pub issued_at: Timestamp,
+    /// Permit expiration timestamp.
+    pub expires_at: Timestamp,
+    /// Current permit lifecycle state.
+    pub state: PermitState,
+    /// Kernel target covered by the permit.
+    pub target: TargetId,
+}
+
+impl ExecutionPermit {
+    /// Validates the local, non-cryptographic execution conditions.
+    ///
+    /// Timestamps must use canonical UTC/ISO-8601 representation so lexical
+    /// ordering remains deterministic.
+    pub fn validate(&self, now: &Timestamp) -> Result<(), GovernanceError> {
+        if self.certification_id.as_str().is_empty() {
+            return Err(GovernanceError::MissingReference("certification_id"));
+        }
+        if self.evidence_hash.as_str().is_empty() {
+            return Err(GovernanceError::MissingReference("evidence_hash"));
+        }
+        if self.target.as_str().is_empty() {
+            return Err(GovernanceError::MissingReference("target"));
+        }
+        if self.authority_signature.as_str().is_empty() {
+            return Err(GovernanceError::MissingAuthoritySignature);
+        }
+        if self.state != PermitState::Active {
+            return Err(GovernanceError::PermitNotActive);
+        }
+        if now.as_str() < self.issued_at.as_str() || now.as_str() > self.expires_at.as_str() {
+            return Err(GovernanceError::PermitOutsideValidityWindow);
+        }
+        Ok(())
+    }
+}
+
+/// Quay's immutable proof of a state transition.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct StateProof {
+    /// Resulting state identity.
+    pub state_id: StateId,
+    /// Parent state, if this is not the genesis state.
+    pub parent_state: Option<StateId>,
+    /// Hash of the state transition.
+    pub transition_hash: TransitionHash,
+    /// Hash of the governing certification.
+    pub certification_hash: CertificationHash,
+    /// Evidence digest for the transition.
+    pub evidence_hash: EvidenceHash,
+    /// Transition timestamp.
+    pub timestamp: Timestamp,
+    /// Integrity proof anchoring the record.
+    pub integrity_proof: IntegrityProof,
+}
+
+impl StateProof {
+    /// Validates that the proof contains every mandatory provenance reference.
+    pub fn validate(&self) -> Result<(), GovernanceError> {
+        let required = [
+            (self.state_id.as_str(), "state_id"),
+            (self.transition_hash.as_str(), "transition_hash"),
+            (self.certification_hash.as_str(), "certification_hash"),
+            (self.evidence_hash.as_str(), "evidence_hash"),
+            (self.integrity_proof.as_str(), "integrity_proof"),
+        ];
+        for (value, name) in required {
+            if value.is_empty() {
+                return Err(GovernanceError::InvalidStateProof(name));
+            }
+        }
+        Ok(())
+    }
+}
+
+/// Verification boundary for cryptographic authority checks.
+pub trait AuthorityVerifier {
+    /// Verifies that a signature is authorized for a certification and target.
+    fn verify(
+        &self,
+        signature: &Signature,
+        certification_id: &CertificationId,
+        target: &TargetId,
+    ) -> Result<(), GovernanceError>;
+}
+
+/// Contract implemented by kernel components that require governance.
+pub trait GovernanceAware {
+    /// Validates governance conditions before execution.
+    fn validate_before_execution(&self) -> Result<(), GovernanceError>;
+
+    /// Certifies the state change before execution.
+    fn certify_state_change(&self) -> Result<CertificationRecord, GovernanceError>;
+}
