    Serialization(String),
}

impl std::fmt::Display for TelemetryError {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            Self::RuntimeUnavailable(msg) =>
                write!(f, "Runtime unavailable: {}", msg),

            Self::InvalidSnapshot(msg) =>
                write!(f, "Invalid snapshot: {}", msg),

            Self::Timeout(d) =>
                write!(f, "Telemetry timeout after {:?}", d),

            Self::FederationUnavailable(msg) =>
                write!(f, "Federation unavailable: {}", msg),

            Self::Serialization(msg) =>
                write!(f, "Serialization error: {}", msg),
        }
    }
}

