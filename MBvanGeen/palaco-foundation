    pub fn new(health_score_threshold: f64) -> Self {
        Self { health_score_threshold }
    }

    /// Evaluates a node health score, returning the appropriate verdict.
    pub fn evaluate_health(&self, health_score: f64) -> EvaluationVerdict {
        if health_score < 0.20 {
            EvaluationVerdict::InvariantBreach
