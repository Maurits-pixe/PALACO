//! across the federated PALACO mesh network.

use serde::{Deserialize, Serialize};
use palaco_foundation::types::NodeId;

/// Represents verified routing and cryptographic identity information for a peer node.
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct PeerInfo {
    /// Unique cryptographic node identifier.
    pub node_id: NodeId,
    /// Network endpoint address (e.g., IP:port or multiaddr string).
    pub endpoint: String,
    /// Unix timestamp in milliseconds when the peer was last verified active.
    pub last_seen_ms: u64,
}

/// Manages active peer rosters and node liveliness tracking.
#[derive(Default)]
pub struct PeerDiscovery {
    peers: Vec<PeerInfo>,
}

impl PeerDiscovery {
    /// Initializes a new peer discovery manager.
    pub fn new() -> Self {
        Self::default()
    }

    /// Registers or updates a peer node within the discovery roster.
    pub fn register_peer(&mut self, peer: PeerInfo) {
        if let Some(existing) = self.peers.iter_mut().find(|p| p.node_id == peer.node_id) {
            existing.endpoint = peer.endpoint;
            existing.last_seen_ms = peer.last_seen_ms;
        } else {
            self.peers.push(peer);
        }
    }

    /// Returns the total count of registered active peers.
    pub fn peer_count(&self) -> usize {
        self.peers.len()
    }

    /// Retrieves a reference to a peer by node identifier.
    pub fn get_peer(&self, node_id: &NodeId) -> Option<&PeerInfo> {
        self.peers.iter().find(|p| &p.node_id == node_id)
    }
}

