+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct CertificationHash(String);
+
+impl CertificationHash {
+    /// Creates a certification digest.
+    pub fn new(value: impl Into<String>) -> Self { Self(value.into()) }
