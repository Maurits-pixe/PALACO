use crate::replay::{ReplayRegistry, ReplayError};
use crate::quarantine::{QuarantinedRecord, FailureReason};

impl QuayEngine {
    /// Processes a raw record with integrated replay protection.
    pub fn process_with_replay(
        registry: &mut ReplayRegistry,
        record: crate::model::QuayRecord,
        provenance: crate::provenance::Provenance,
        evidence: crate::evidence::EvidenceBundle,
        current_timestamp_nanos: u64,
    ) -> QuayResult {
        // 0. Check Replay Registry first
        if let Err(ReplayError::ReplayDetected(id)) = registry.check_replay(record.id()) {
            let quarantine = QuarantinedRecord::isolate(
                record,
                FailureReason::InvariantBreach("Replay attack detected: duplicate RecordId"),
                current_timestamp_nanos,
            );
            return QuayResult::Quarantined(quarantine);
        }

        // 1. Validate Provenance
        if let Err(err) = provenance.validate_integrity() {
            let quarantine = QuarantinedRecord::isolate(
                record,
                FailureReason::ProvenanceFailed(err),
                current_timestamp_nanos,
            );
            return QuayResult::Quarantined(quarantine);
        }

        // 2. Issue StateProof
        let proof = match crate::proof::StateProof::issue(&record, evidence) {
            Ok(p) => p,
            Err(err) => {
                let reason = match err {
                    crate::proof::StateProofError::EvidenceVerificationFailed(e) => FailureReason::EvidenceFailed(e),
                    other => FailureReason::ProofFailed(other),
                };
                let quarantine = QuarantinedRecord::isolate(
                    record,
                    reason,
                    current_timestamp_nanos,
                );
                return QuayResult::Quarantined(quarantine);
            }
        };

        // 3. Register successfully verified ID to prevent future replays
        if let Err(_) = registry.register(record.id().clone()) {
            let quarantine = QuarantinedRecord::isolate(
                record,
                FailureReason::InvariantBreach("Failed to register record in replay registry"),
                current_timestamp_nanos,
            );
            return QuayResult::Quarantined(quarantine);
        }

        // 4. Seal into ProvenQuayRecord
        match proof.seal(record, provenance) {
            Ok(proven) => QuayResult::Accepted(proven),
            Err(err) => {
                let dummy_record = crate::model::RecordId("FATAL_SEAL_FAILURE".into());
                let fallback = crate::model::QuayRecord::new(dummy_record, vec![], crate::model::SourceId("SYSTEM".into()));
                let quarantine = QuarantinedRecord::isolate(
                    fallback,
                    FailureReason::ProofFailed(err),
                    current_timestamp_nanos,
                );
                QuayResult::Quarantined(quarantine)
            }
        }
    }
}

