//! # palaco-federation::tests
//!
//! Comprehensive unit and integration test suites for `palaco-federation`.

#[cfg(test)]
mod federation_tests {
    use super::*;
    use palaco_foundation::types::NodeId;

    #[test]
    fn test_peer_discovery_registration() {
        let mut discovery = PeerDiscovery::new();
        assert_eq!(discovery.peer_count(), 0);

        let node_id = NodeId([10u8; 32]);
        let peer = PeerInfo {
            node_id,
            endpoint: "192.168.1.50:8080".to_string(),
            last_seen_ms: 1785840000000,
        };

        discovery.register_peer(peer);
        assert_eq!(discovery.peer_count(), 1);

        let retrieved = discovery.get_peer(&node_id).expect("Peer should be registered");
        assert_eq!(retrieved.endpoint, "192.168.1.50:8080");
    }

    #[test]
    fn test_federation_mesh_initialization() {
        let local_id = NodeId([1u8; 32]);
        let mesh = FederationMesh::new(local_id, MeshTopology::GossipMesh);

        assert_eq!(mesh.local_node_id(), local_id);
        assert_eq!(mesh.topology(), MeshTopology::GossipMesh);
        assert_eq!(mesh.discovery().peer_count(), 0);
    }
}


