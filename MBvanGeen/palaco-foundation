                current_timestamp_nanos,
            );
            return QuayResult::Quarantined(quarantine);
        }

        // 1. Validate Provenance
        if let Err(err) = provenance.validate_integrity() {
            let quarantine = QuarantinedRecord::isolate(
                record,
                FailureReason::ProvenanceFailed(err),
                current_timestamp_nanos,
            );
            return QuayResult::Quarantined(quarantine);
        }

