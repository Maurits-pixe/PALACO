}

impl Default for ProposalSandbox {
    fn default() -> Self {
        Self { max_acceptable_risk: 25 }
    }
}

impl ProposalSandbox {
    /// Creates a new proposal sandbox with strict risk boundaries.
    pub fn new(max_acceptable_risk: u8) -> Self {
        Self { max_acceptable_risk }
    }

    /// Simulates a proposal and updates its state based on risk evaluation.
    pub fn simulate(&self, proposal: &mut EvolutionProposal) -> Result<SandboxResult, EvolutionError> {
        // Mock evaluation logic simulating invariant verification
        let evaluated_risk = proposal.risk_score;
        let safe = evaluated_risk <= self.max_acceptable_risk;

        if safe {
            proposal.state = ProposalState::Simulated;
        } else {
            proposal.state = ProposalState::Rejected;
        }

        Ok(SandboxResult {
            proposal_id: proposal.id,
            safe_to_merge: safe,
            evaluated_risk_score: evaluated_risk,
            diagnostic_message: if safe {
                "Sandbox simulation passed successfully without invariant violations.".to_string()
            } else {
                "Sandbox simulation failed: evaluated risk score exceeds maximum threshold.".to_string()
            },
        })
    }
