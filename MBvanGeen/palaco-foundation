//! # palaco-telemetry::evidence
//!
//! Cryptographic Merkle evidence trees providing mathematical proof of state
//! transitions and systemic integrity across PALACO nodes.

use serde::{Deserialize, Serialize};

/// Represents a node within the cryptographic Merkle evidence tree.
#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
pub enum EvidenceNode {
    /// A leaf node containing a verified event or state hash.
    Leaf {
        /// Unique hash of the underlying evidence payload.
        hash: Hash256,
    },
    /// An internal branch combining left and right child nodes.
    Branch {
        /// Combined cryptographic hash of the branch.
        hash: Hash256,
        /// Boxed left child reference.
        left: Box<EvidenceNode>,
        /// Boxed right child reference.
        right: Box<EvidenceNode>,
    },
}

impl EvidenceNode {
    /// Retrieves the root hash of the evidence node (leaf or branch).
    pub fn hash(&self) -> Hash256 {
        match self {
            Self::Leaf { hash } => *hash,
            Self::Branch { hash, .. } => *hash,
        }
    }
}

/// A complete Merkle evidence tree structure for auditing state integrity.
#[derive(Debug, Clone)]
pub struct MerkleTree {
    root: Option<EvidenceNode>,
    leaf_count: usize,
}

impl MerkleTree {
    /// Creates a new, empty Merkle evidence tree.
    pub fn new() -> Self {
        Self {
            root: None,
            leaf_count: 0,
        }
    }

    /// Returns the total number of leaves recorded in the tree.
    pub fn leaf_count(&self) -> usize {
        self.leaf_count
    }

    /// Returns the root hash of the tree if initialized.
    pub fn root_hash(&self) -> Option<Hash256> {
        self.root.as_ref().map(|node| node.hash())
    }
}

impl Default for MerkleTree {
    fn default() -> Self {
        Self::new()
    }
}

//! # palaco-telemetry::ledger
//!
//! Append-only cryptographic ledger storing verified evidence payloads
//! and constitutional checkpoints.

use std::collections::VecDeque;

/// Represents an immutable entry committed to the evidence ledger.
#[derive(Debug, Clone)]
pub struct LedgerEntry {
    pub sequence: u64,
    pub evidence_hash: Hash256,
    pub timestamp_ms: u64,
    pub node_id: NodeId,
}

/// Append-only ledger storing verified evidence records.
pub struct EvidenceLedger {
    entries: VecDeque<LedgerEntry>,
    next_sequence: u64,
}

impl Default for EvidenceLedger {
    fn default() -> Self {
        Self {
            entries: VecDeque::new(),
            next_sequence: 0,
        }
    }
}

impl EvidenceLedger {
    /// Initializes a new evidence ledger instance.
    pub fn new() -> Self {
        Self::default()
    }

    /// Appends a new verified evidence hash to the ledger stream.
    pub fn append(&mut self, evidence_hash: Hash256, node_id: NodeId, timestamp_ms: u64) -> u64 {
        let sequence = self.next_sequence;
        self.next_sequence += 1;

        let entry = LedgerEntry {
            sequence,
            evidence_hash,
            timestamp_ms,
            node_id,
        };

        self.entries.push_back(entry);
        sequence
    }

    /// Retrieves an entry by its sequence number.
    pub fn get(&self, sequence: u64) -> Option<&LedgerEntry> {
        self.entries.iter().find(|e| e.sequence == sequence)
    }

    /// Returns the total number of entries recorded in the ledger.
    pub fn len(&self) -> usize {
        self.entries.len()
    }

    /// Returns true if the ledger contains no entries.
    pub fn is_empty(&self) -> bool {
        self.entries.is_empty()
    }
}

