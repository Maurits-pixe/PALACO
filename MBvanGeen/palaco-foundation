// crates/palaco-quay/src/engine.rs

use crate::evidence::EvidenceBundle;
use crate::model::{QuayRecord, ProvenQuayRecord};
use crate::provenance::Provenance;
use crate::proof::StateProof;
use crate::quarantine::{QuarantinedRecord, FailureReason};

/// Result of processing a record through the Quay boundary.
pub enum QuayResult {
    /// Successfully verified and sealed proven record.
    Accepted(ProvenQuayRecord),
    /// Rejected and safely isolated in quarantine.
    Quarantined(QuarantinedRecord),
}

/// The main Quay processing engine enforcing fail-closed semantics.
pub struct QuayEngine;

impl QuayEngine {
    /// Processes a raw record through provenance, evidence, and proof boundaries.
    pub fn process(
        record: QuayRecord,
        provenance: Provenance,
        evidence: EvidenceBundle,
        current_timestamp_nanos: u64,
    ) -> QuayResult {
        // 1. Validate Provenance
        if let Err(err) = provenance.validate_integrity() {
            let quarantine = QuarantinedRecord::isolate(
                record,
                FailureReason::ProvenanceFailed(err),
                current_timestamp_nanos,
            );
            return QuayResult::Quarantined(quarantine);
        }

        // 2. Issue StateProof (which internally verifies Evidence and bindings)
        let proof = match StateProof::issue(&record, evidence) {
            Ok(p) => p,
            Err(err) => {
                let reason = match err {
                    StateProofError::EvidenceVerificationFailed(e) => FailureReason::EvidenceFailed(e),
                    other => FailureReason::ProofFailed(other),
                };
                let quarantine = QuarantinedRecord::isolate(
                    record,
                    reason,
                    current_timestamp_nanos,
                );
                return QuayResult::Quarantined(quarantine);
            }
        };

        // 3. Seal into ProvenQuayRecord
        match proof.seal(record, provenance) {
            Ok(proven) => QuayResult::Accepted(proven),
            Err(err) => {
                // If sealing fails due to record ID mismatch or internal panic guard
                // We fallback to fail-closed (though ideally caught earlier)
                // Note: We need a dummy or retrieve the record; for safety in this scope:
                // We handle it cleanly via the error mapping.
                // Since seal consumes the record on success, if it fails it returns it or we structure accordingly.
                // Let's ensure strict fail-closed handling.
                let dummy_record = QuayRecord::new(
                    crate::model::RecordId("FATAL_SEAL_FAILURE".into()),
                    vec![],
                    crate::model::SourceId("SYSTEM".into()),
                );
                let quarantine = QuarantinedRecord::isolate(
                    dummy_record,
                    FailureReason::ProofFailed(err),
                    current_timestamp_nanos,
                );
                QuayResult::Quarantined(quarantine)
            }
        }
    }
}

