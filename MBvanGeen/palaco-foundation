}

impl RawTelemetrySnapshot {
    pub fn validate(&self) -> Result<(), TelemetryError> {
        if self.version.trim().is_empty() {
            return Err(TelemetryError::InvalidSnapshot("version missing".into()));
        }

        if self.git_commit.trim().is_empty() {
            return Err(TelemetryError::InvalidSnapshot("git commit missing".into()));
        }

        if self.snapshot_timestamp < self.build_timestamp {
            return Err(TelemetryError::InvalidSnapshot("snapshot older than build".into()));
        }

        Ok(())
    }
