use serde::{Serialize, Deserialize};
use sha2::{Sha256, Digest};

/// Failure reason encapsulating error provenance for QUAY-006 fail-closed isolation.
#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
pub struct FailureReason {
    /// Error category code.
    pub code: String,
    /// Detailed diagnostic message.
    pub message: String,
    /// Timestamp of failure detection.
    pub timestamp: i64,
}

/// Quarantined record ensuring strict provenance retention on sealing failure (QUAY-006).
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct QuarantinedRecord {
    /// The original raw record payload that failed sealing.
    pub original_payload: Vec<u8>,
    /// The captured failure reason.
    pub reason: FailureReason,
    /// Cryptographic provenance hash of the failure event.
    pub provenance_hash: [u8; 32],
}

impl QuarantinedRecord {
    /// Constructs a new `QuarantinedRecord` with preserved provenance.
    pub fn new(original_payload: Vec<u8>, reason: FailureReason) -> Self {
        let mut hasher = Sha256::new();
        hasher.update(&original_payload);
        hasher.update(reason.code.as_bytes());
        hasher.update(reason.timestamp.to_be_bytes());
        
        let mut provenance_hash = [0u8; 32];
        provenance_hash.copy_from_slice(&hasher.finalize());

        Self {
            original_payload,
            reason,
            provenance_hash,
        }
    }
}

/// Replay registry enforcing that registration occurs exclusively after a successful seal (QUAY-007).
#[derive(Debug, Default)]
pub struct ReplayRegistry {
    sealed_records: Vec<[u8; 32]>,
}

impl ReplayRegistry {
    /// Creates a new empty ReplayRegistry.
    pub fn new() -> Self {
        Self {
            sealed_records: Vec::new(),
        }
    }

    /// Registers a state proof seal strictly after verification and sealing (QUAY-007).
    pub fn register(&mut self, state_proof_seal: [u8; 32]) -> Result<(), &'html str> {
        if state_proof_seal == [0u8; 32] {
            return Err("QUAY-007 Violation: Cannot register null state proof seal.");
        }
        self.sealed_records.push(state_proof_seal);
        Ok(())
    }

    /// Returns the count of successfully registered seals.
    pub fn len(&self) -> usize {
        self.sealed_records.len()
    }

    /// Checks if registry is empty.
    pub fn is_empty(&self) -> bool {
        self.sealed_records.is_empty()
    }
}

