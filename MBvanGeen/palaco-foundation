//! # palaco-observatory::alert
//!
//! Severity-based alert management and automated incident dispatching
//! for constitutional violations and node anomalies.

use serde::{Deserialize, Serialize};

/// Severity level for system alerts generated by the observatory.
#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Serialize, Deserialize)]
pub enum AlertLevel {
    /// Informational notice regarding system state changes.
    Notice = 0,
    /// Warning indicating elevated resource usage or minor drift.
    Warning = 1,
    /// Critical alert signifying an active constitutional invariant breach.
    Critical = 2,
    /// Emergency lockdown directive requiring immediate isolation.
    EmergencyLockdown = 3,
}

/// Represents a structured system alert emitted by the observatory.
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct SystemAlert {
    /// Unique alert identifier or sequence.
    pub alert_id: u64,
    /// Severity classification of the alert.
    pub level: AlertLevel,
    /// Subsystem origin identifier.
    pub source_subsystem: String,
    /// Human-readable description of the anomaly.
    pub description: String,
    /// Unix timestamp in milliseconds when the alert was triggered.
    pub timestamp_ms: u64,
}

/// Manages active alerts and dispatches lockdown notifications.
#[derive(Default)]
pub struct AlertManager {
    alerts: Vec<SystemAlert>,
    next_id: u64,
}

impl AlertManager {
    /// Initializes a new alert manager.
    pub fn new() -> Self {
        Self::default()
    }

    /// Raises a new system alert and returns its assigned identifier.
    pub fn raise_alert(&mut self, level: AlertLevel, source_subsystem: String, description: String, timestamp_ms: u64) -> u64 {
        let alert_id = self.next_id;
        self.next_id += 1;

        let alert = SystemAlert {
            alert_id,
            level,
            source_subsystem,
            description,
            timestamp_ms,
        };

        self.alerts.push(alert);
        alert_id
    }

    /// Returns the total number of active/logged alerts.
    pub fn alert_count(&self) -> usize {
        self.alerts.len()
    }

    /// Returns true if any active alert has reached emergency lockdown severity.
    pub fn has_emergency(&self) -> bool {
        self.alerts.iter().any(|a| a.level == AlertLevel::EmergencyLockdown)
    }
}

