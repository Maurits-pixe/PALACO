2. PostgreSQL — eerste schema

De database krijgt UUID/ULID-achtige interne identifiers en aparte publieke references.

CREATE EXTENSION IF NOT EXISTS pgcrypto;

CREATE TYPE record_status AS ENUM (
    'ACTIVE',
    'SUSPENDED',
    'REVOKED',
    'EXPIRED',
    'ARCHIVED'
);

CREATE TYPE identity_type AS ENUM (
    'PERSON',
    'ORGANIZATION',
    'SERVICE'
);

CREATE TYPE relationship_role AS ENUM (
    'STEWARD',
    'MEMBER',
    'ISSUER',
    'OBSERVER',
    'PARTNER'
);

CREATE TABLE citadels (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    canonical_name TEXT NOT NULL,
    slug TEXT NOT NULL UNIQUE,
    description TEXT,
    status record_status NOT NULL DEFAULT 'ACTIVE',
    version INTEGER NOT NULL DEFAULT 1,
    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

CREATE TABLE identities (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    identity_type identity_type NOT NULL,
    public_name TEXT NOT NULL,
    status record_status NOT NULL DEFAULT 'ACTIVE',
    visibility TEXT NOT NULL DEFAULT 'PUBLIC',
    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
);


