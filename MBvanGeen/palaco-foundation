2. Verificatie en Binding
Een EvidenceBundle is pas waardevol als het cryptografisch en logisch bindt aan de payload en de provenance. We voegen de validatielogica toe:
impl EvidenceBundle {
    /// Verifies all internal artifacts and ensures cryptographic binding.
    pub fn verify_all(&self) -> Result<(), EvidenceError> {
        if self.artifacts.is_empty() {
            return Err(EvidenceError::MissingEvidenceArtifacts);
        }

        // Validate provenance integrity as part of the evidence chain
        self.provenance.validate_integrity()
            .map_err(|_| EvidenceError::InvalidProvenanceChain)?;

        // Iterate through artifacts and perform checks
        for artifact in &self.artifacts {
            match artifact.evidence_type() {
                EvidenceType::CryptographicSignature => {
                    if artifact.proof_bytes().is_empty() {
                        return Err(EvidenceError::MalformedArtifact);
                    }
                    // Cryptographic verification logic placeholder / hook
                }
                EvidenceType::InvariantValidation => {
                    if artifact.proof_bytes().is_empty() {
                        return Err(EvidenceError::MalformedArtifact);
                    }
                }
                EvidenceType::Attestation => {
                    if artifact.proof_bytes().is_empty() {
                        return Err(EvidenceError::MalformedArtifact);
                    }
                }
            }
        }

        Ok(())
    }
}

